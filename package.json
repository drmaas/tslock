{
  "name": "tslock",
  "version": "1.0.0",
  "private": true,
  "description": "TSLock monorepo — distributed locks for scheduled tasks in TypeScript",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r test:integration",
    "check:packed-peers": "node scripts/check-packed-peers.mjs",
    "bench": "pnpm build && node benchmarks/lock-overhead.mjs",
    "build": "pnpm -r build",
    "version-packages": "changeset version",
    "release": "pnpm check && pnpm build && pnpm test && pnpm check:packed-peers && npx changeset publish",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^22.20.1",
    "husky": "^9.1.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
