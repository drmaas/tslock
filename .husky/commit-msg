#!/usr/bin/env sh

# Validate Conventional Commits format and issue reference
# Pattern: type(scope): description  OR  type: description

COMMIT_MSG=$(cat "$1")
FIRST_LINE=$(echo "$COMMIT_MSG" | head -n1)

# Check Conventional Commits format
if ! echo "$FIRST_LINE" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_-]+\))?: .+'; then
  echo "❌ Commit message must follow Conventional Commits format."
  echo "   Expected: type(scope): description"
  echo "   Examples: feat(redis): add safeUpdate option"
  echo "             fix(s3): throw on 404 in updateRecord"
  echo "             docs(core): clarify LockExtender semantics"
  echo "             chore: bump Node minimum to 22"
  exit 1
fi

# Check issue reference in footer
if ! echo "$COMMIT_MSG" | grep -qE '(#[0-9]+|Closes #[0-9]+)'; then
  echo "❌ Commit message must reference an issue."
  echo "   Include #<NN> or Closes #<NN> in the footer."
  exit 1
fi
