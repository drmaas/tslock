{
  "name": "@tslock/drizzle",
  "version": "2.0.1",
  "description": "TSLock SQL provider using Drizzle ORM",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@tslock/core": "workspace:*",
    "@tslock/sql-support": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "peerDependenciesMeta": {
    "@tslock/core": {
      "optional": false
    },
    "@tslock/sql-support": {
      "optional": false
    },
    "drizzle-orm": {
      "optional": false
    }
  },
  "devDependencies": {
    "@tslock/core": "workspace:*",
    "@tslock/sql-support": "workspace:*",
    "@tslock/test-support": "workspace:*",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/pg": "^8.10.0",
    "pg": "^8.11.0",
    "typescript": "^5.5.0",
    "tsup": "^8.0.0",
    "vitest": "^3.2.6",
    "drizzle-orm": "^0.45.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drmaas/tslock.git",
    "directory": "packages/drizzle"
  },
  "sideEffects": false
}
