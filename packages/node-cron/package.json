{
  "name": "@tslock/node-cron",
  "version": "2.0.1",
  "description": "TSLock adapter for node-cron scheduled tasks",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "node ../../scripts/tsup.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tslock/core": "workspace:*",
    "@tslock/scheduler-core": "workspace:*"
  },
  "peerDependencies": {
    "node-cron": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "node-cron": {
      "optional": false
    }
  },
  "devDependencies": {
    "@tslock/core": "workspace:*",
    "@tslock/in-memory": "workspace:*",
    "@tslock/scheduler-core": "workspace:*",
    "node-cron": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drmaas/tslock.git",
    "directory": "packages/node-cron"
  },
  "sideEffects": false
}
