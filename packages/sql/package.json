{
  "name": "@tslock/sql",
  "version": "2.2.0",
  "description": "TSLock SQL provider for raw Node.js drivers (pg, mysql2, mssql)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/tsup.cjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@tslock/core": "workspace:*",
    "@tslock/sql-support": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@tslock/core": {
      "optional": false
    },
    "@tslock/sql-support": {
      "optional": false
    }
  },
  "devDependencies": {
    "@tslock/core": "workspace:*",
    "@tslock/sql-support": "workspace:*",
    "@tslock/test-support": "workspace:*",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.10.0",
    "mssql": "^12.7.0",
    "mysql2": "^3.23.1",
    "pg": "^8.11.0",
    "@testcontainers/postgresql": "^12.1.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drmaas/tslock.git",
    "directory": "packages/sql"
  },
  "sideEffects": false
}
