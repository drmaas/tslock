{
  "name": "@tslock/bree",
  "version": "2.0.1",
  "description": "TSLock adapter for Bree job workers",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tslock/core": "workspace:*",
    "@tslock/scheduler-core": "workspace:*"
  },
  "peerDependencies": {
    "bree": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "bree": {
      "optional": false
    }
  },
  "devDependencies": {
    "@tslock/core": "workspace:*",
    "@tslock/in-memory": "workspace:*",
    "@tslock/scheduler-core": "workspace:*",
    "bree": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drmaas/tslock.git",
    "directory": "packages/bree"
  },
  "sideEffects": false
}
