{
  "name": "@tslock/redis",
  "version": "1.0.2",
  "description": "TSLock Redis provider using node-redis",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@tslock/core": "workspace:*",
    "@tslock/redis-core": "workspace:*",
    "redis": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@tslock/core": {
      "optional": false
    },
    "@tslock/redis-core": {
      "optional": false
    },
    "redis": {
      "optional": false
    }
  },
  "devDependencies": {
    "@tslock/core": "workspace:*",
    "@tslock/redis-core": "workspace:*",
    "@tslock/test-support": "workspace:*",
    "typescript": "^5.5.0",
    "tsup": "^8.0.0",
    "vitest": "^2.0.0",
    "redis": "^4.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drmaas/tslock.git",
    "directory": "packages/redis"
  },
  "sideEffects": false
}
