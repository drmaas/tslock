{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "@tslock/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/__tests__/**/*.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}
